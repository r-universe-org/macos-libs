prefix=/opt/R/x86_64
exec_prefix=${prefix}
libdir=/opt/R/x86_64/lib
includedir=/opt/R/x86_64/include

Name: absl_random_internal_randen_hwaes
Description: Abseil random_internal_randen_hwaes library
URL: https://abseil.io/
Version: 20250127
Requires: absl_random_internal_platform = 20250127, absl_random_internal_randen_hwaes_impl = 20250127, absl_config = 20250127, absl_optional = 20250127
Libs: -L${libdir}  -labsl_random_internal_randen_hwaes 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -DNOMINMAX -Wno-unused-command-line-argument
