prefix=/opt/R/x86_64
exec_prefix=${prefix}
libdir=/opt/R/x86_64/lib
includedir=/opt/R/x86_64/include

Name: absl_log_internal_conditions
Description: Abseil log_internal_conditions library
URL: https://abseil.io/
Version: 20250127
Requires: absl_base = 20250127, absl_config = 20250127, absl_core_headers = 20250127, absl_log_internal_voidify = 20250127
Libs: -L${libdir}  -labsl_log_internal_conditions 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -DNOMINMAX
