prefix=/opt/R/x86_64
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
ccompiler=gcc

Name: netcdf-c
Description: NetCDF Client Library for C
URL: https://www.unidata.ucar.edu/netcdf
Version: 4.9.2
Libs: -L${libdir} -L/opt/R/x86_64/lib -lnetcdf -lhdf5_hl -lhdf5 -lm -lz -lbz2 -lzstd -lxml2 -lcurl -L/opt/R/x86_64/lib -lsz
Libs.private: -lhdf5_hl -lhdf5 -lm -lz -lbz2 -lzstd -lxml2 -lcurl -L/opt/R/x86_64/lib -lsz
Cflags: -I${includedir}
