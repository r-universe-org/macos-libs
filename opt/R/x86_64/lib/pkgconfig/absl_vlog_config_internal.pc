prefix=/opt/R/x86_64
exec_prefix=${prefix}
libdir=/opt/R/x86_64/lib
includedir=/opt/R/x86_64/include

Name: absl_vlog_config_internal
Description: Abseil vlog_config_internal library
URL: https://abseil.io/
Version: 20250127
Requires: absl_base = 20250127, absl_config = 20250127, absl_core_headers = 20250127, absl_log_internal_fnmatch = 20250127, absl_memory = 20250127, absl_no_destructor = 20250127, absl_strings = 20250127, absl_synchronization = 20250127, absl_optional = 20250127
Libs: -L${libdir}  -labsl_vlog_config_internal 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -DNOMINMAX
