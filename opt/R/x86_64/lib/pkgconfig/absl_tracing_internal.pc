prefix=/opt/R/x86_64
exec_prefix=${prefix}
libdir=/opt/R/x86_64/lib
includedir=/opt/R/x86_64/include

Name: absl_tracing_internal
Description: Abseil tracing_internal library
URL: https://abseil.io/
Version: 20250127
Requires: absl_base = 20250127
Libs: -L${libdir}  -labsl_tracing_internal 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -DNOMINMAX
